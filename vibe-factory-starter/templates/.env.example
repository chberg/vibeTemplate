# Copy to .env and fill in. Never commit .env.

# Codex / OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# OpenRouter (for Hermes)
OPENROUTER_API_KEY=

# Local model endpoints
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://192.168.x.x:8000/v1

# Driver selection for once.sh / afk-loop.sh
VIBE_DRIVER=codex

# AFK loop bounds
MAX_ITERATIONS=20
SLEEP_BETWEEN=5
